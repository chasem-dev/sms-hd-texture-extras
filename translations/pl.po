#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 20 characters
#. AI-generated
#: common/sys_message:0
msgid ""
"Howdy! Throw me a{choice1:Yes}{choice2:No}\n"
"coin, and I'll throw\n"
"you for a loop!"
msgstr ""
"Hej! Rzuć mi {choice1:Tak}{choice2:Nie}\n"
"monetę, a ja cię\n"
"nieźle zakręcę!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 23 characters
#. AI-generated
#: common/sys_message:1
msgid ""
"{close}Yeeaaah!\n"
"And awaaaaay you go!{speed:50} {speed:0}"
msgstr ""
"{close}Yeeee!\n"
"I w dolo!{speed:50} {speed:0}"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 22 characters
#. AI-generated
#: common/sys_message:2
msgid ""
"A single coin may\n"
"have the power to\n"
"change your destiny..."
msgstr ""
"Pojedyncza moneta może\n"
"mieć moc, aby\n"
"zmienić twój los..."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 17 characters
#. AI-generated
#: common/sys_message:3
msgid ""
"!!!ERROR!!!\n"
"Message could not\n"
"be loaded."
msgstr ""
"!!!BŁĄD!!!\n"
"Nie można wczytać\n"
"wiadomości."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 11 characters
#. AI-generated
#: common/sys_message:4
msgid ""
"!!!ERROR!!!\n"
"Unspecified\n"
"Message ID."
msgstr ""
"!!!BŁĄD!!!\n"
"Nieznany\n"
"ID wiadomości."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 6 lines, the longest 20 characters
#. AI-generated
#: common/sys_message:5
msgid ""
"Hellooooooo!\n"
"You want to work for\n"
"me for a little bit?\n"
"I'd love for you to\n"
"bring me some fruit.\n"
"I'm craving some..."
msgstr ""
"HejHejHej!\n"
"Chcesz trochę\n"
"u mnie popracować?\n"
"Chciałbym, żebyś\n"
"przyniósł mi owoce.\n"
"Mam ochotę na..."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 11 characters
#. AI-generated
#: common/sys_message:6 common/sys_message:14
msgid ""
"...bananas!\n"
"Bring me {value:4:0},\n"
"would you?"
msgstr ""
"...banany!\n"
"Przynieś mi {value:4:0},\n"
"może?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 12 characters
#. AI-generated
#: common/sys_message:7 common/sys_message:15
msgid ""
"...coconuts!\n"
"Bring me {value:4:1},\n"
"would you?"
msgstr ""
"...kokosów!\n"
"Przynieś mi {value:4:1},\n"
"może być?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 14 characters
#. AI-generated
#: common/sys_message:8 common/sys_message:16
msgid ""
"...pineapples!\n"
"Bring me {value:4:2},\n"
"would you?"
msgstr ""
"...ananasów!\n"
"Przynieś mi {value:4:2},\n"
"co powiesz?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 11 characters
#. AI-generated
#: common/sys_message:9 common/sys_message:17
msgid ""
"...durians!\n"
"Bring me {value:4:3},\n"
"would you?"
msgstr ""
"...durians!\n"
"Przynieś mi {value:4:3},\n"
"może?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 20 characters
#. AI-generated
#: common/sys_message:10
msgid ""
"Just bring the fruit\n"
"here and put it\n"
"in this basket, OK?"
msgstr ""
"Przynieś owoce,\n"
"połóż je tutaj,\n"
"w tym koszyku, OK?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 19 characters
#. AI-generated
#: common/sys_message:11
msgid ""
"Well? Are you going\n"
"to do it, or what?\n"
"I need some..."
msgstr ""
"No i jak? Zrobisz to\n"
"czy co?\n"
"Potrzebuję..."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 20 characters
#. AI-generated
#: common/sys_message:12
msgid ""
"Nice job!\n"
"Here's your payment!"
msgstr ""
"Dobra robota!\n"
"Oto twoja zapłata!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 20 characters
#. AI-generated
#: common/sys_message:13
msgid ""
"I might just ask for\n"
"your help again..."
msgstr ""
"Może znów poproszę\n"
"o twoją pomoc..."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 5 lines, the longest 23 characters
#. AI-generated
#: common/sys_message:18
msgid ""
"Break all of the crates\n"
"within 30 seconds to\n"
"win a prize. \n"
"You want to try?\n"
"{choice1:Yes}{choice2:No}"
msgstr ""
"Rozbij wszystkie skrzynie\n"
"w 30 sekund, aby\n"
"zgarnąć nagrodę.\n"
"Chcesz spróbować?\n"
"{choice1:Tak}{choice2:Nie}"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 16 characters
#. AI-generated
#: common/sys_message:19
msgid ""
"Practice up and\n"
"come back later."
msgstr ""
"Poćwicz jeszcze i\n"
"wróć później."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 16 characters
#. AI-generated
#: common/sys_message:20
msgid ""
"That was great!\n"
"You're the best!"
msgstr ""
"To było świetne!\n"
"Jesteś najlepszy!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 1 line, the longest 17 characters
#. AI-generated
#: common/sys_message:21
msgid "Oooh, so close..."
msgstr "Oooh, tak blisko..."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 22 characters
#. AI-generated
#: common/sys_message:22
msgid ""
"Break all the crates{choice1:Yes}{choice2:No}\n"
"within {value:2} seconds to\n"
"win yourself a prize."
msgstr ""
"Rozbij skrzynie{choice1:Tak}{choice2:Nie}\n"
"w ciągu {value:2} sekund,\n"
"by zdobyć nagrodę."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 9 lines, the longest 23 characters
#. AI-generated
#: common/sys_message:23
msgid ""
"What's this, hm?\n"
"Not even 10 coins?\n"
"Then you get nothing!\n"
"I can't drop my\n"
"prices that low.\n"
"That would be madness!\n"
"You'll have to come\n"
"back again, I'm afraid.\n"
"See you later."
msgstr ""
"Co to ma być?\n"
"Nawet 10 monet?\n"
"To nic nie dostaniesz!\n"
"Nie mogę obniżyć\n"
"tak bardzo cen.\n"
"To byłoby szaleństwo!\n"
"Musisz wrócić,\n"
"obawiam się.\n"
"Do zobaczenia."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 5 lines, the longest 21 characters
#. AI-generated
#: common/sys_message:24 common/sys_message:29
msgid ""
"I can exchange those\n"
"for Shine Sprites.\n"
"I'll give you {value:3}, yes?\n"
"Would you like to?\n"
"{choice1:Yes}{choice2:No}"
msgstr ""
"Mogę wymienić je\n"
"na Błyski.\n"
"Dam ci {value:3}, tak?\n"
"Chcesz tak zrobić?\n"
"{choice1:Tak}{choice2:Nie}"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 5 lines, the longest 17 characters
#. AI-generated
#: common/sys_message:25
msgid ""
"Really? You truly\n"
"mean it, yes?\n"
"\n"
"No refunds!\n"
"{choice1:Yes}{choice2:No}"
msgstr ""
"Naprawdę? Naprawdę\n"
"to mówisz, tak?\n"
"\n"
"Brak zwrotów!\n"
"{choice1:Tak}{choice2:Nie}"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 23 characters
#. AI-generated
#: common/sys_message:26
msgid ""
"I'm so sorry I couldn't\n"
"be of service to you.\n"
"See you next time."
msgstr ""
"Bardzo mi przykro, że nie\n"
"mogłem ci pomóc.\n"
"Do zobaczenia."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 5 lines, the longest 22 characters
#. AI-generated
#: common/sys_message:27
msgid ""
"Oh...but it looks like\n"
"we're all out now.\n"
"Don't I feel silly!\n"
"How am I to make a\n"
"living now, hm?"
msgstr ""
"Och... ale wygląda,\n"
"że już wszystko zeszło.\n"
"Czuję się głupio!\n"
"Jak mam teraz, hm,\n"
"zarobić na życie?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 9 lines, the longest 21 characters
#. AI-generated
#: common/sys_message:28
msgid ""
"Welcome! Welcome!\n"
"\n"
"\n"
"I suppose you're here\n"
"for THAT, hm?\n"
"Yes, very good.\n"
"That means I will\n"
"require 10 blue coins\n"
"from you."
msgstr ""
"Witaj! Witaj!\n"
"\n"
"Domyślam się, że\n"
"jesteś tu dla TEGO?\n"
"Tak, bardzo dobrze.\n"
"To oznacza, że\n"
"będę potrzebować\n"
"10 niebieskich monet\n"
"od ciebie."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 6 lines, the longest 19 characters
#. AI-generated
#: common/sys_message:30
msgid ""
"Collect 8 red coins\n"
"before the timer\n"
"runs out!\n"
"\n"
"GOOD LUCK!\n"
msgstr ""
"Zbierz 8 czerwonych\n"
"monet, zanim czas\n"
"upłynie!\n"
"\n"
"POWODZENIA!\n"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 6 lines, the longest 23 characters
#. AI-generated
#: common/sys_message:31
msgid ""
"I love the sunshine,\n"
"but OOOH! Is it\n"
"ever bright!\n"
"Here, little man. Try a\n"
"pair of my special sun\n"
"shades. They're cool!"
msgstr ""
"Uwielbiam słońce,\n"
"ale OOO! Ale ono\n"
"jest jasne!\n"
"Masz, maluchu.\n"
"Moje okulary są\n"
"super!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 1 line, the longest 15 characters
#. AI-generated
#: common/sys_message:32
msgid "You had enough?"
msgstr "Masz dość?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 7 lines, the longest 21 characters
#. AI-generated
#: common/sys_message:33
msgid ""
"Yeah heh heh...\n"
"You're styling now!\n"
"\n"
"Come back and talk to\n"
"me when you don't\n"
"need them anymore.\n"
msgstr ""
"No heh heh...\n"
"Masz teraz styl!\n"
"\n"
"Wróć i porozmawiaj ze\n"
"mną, gdy nie będą\n"
"ci już potrzebne.\n"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 20 characters
#. AI-generated
#: common/sys_message:34
msgid ""
"Come by anytime it's\n"
"too bright for you,\n"
"OK, little man?"
msgstr ""
"Wpadnij, gdy będzie\n"
"za jasno dla ciebie,\n"
"dobra, maluchu?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 12 lines, the longest 22 characters
#. AI-generated
#: common/sys_message:35
msgid ""
"Hey! I think you're in\n"
"need of a pair of my\n"
"special sun shades...\n"
"Ooh, well...\n"
"Then again, maybe\n"
"you're not ready.\n"
"You need to spend a\n"
"bit more time here on\n"
"Isle Delfino.\n"
"Come on back when\n"
"you think you're ready\n"
"for a pair. See ya!"
msgstr ""
"Hej! Myślę, że\n"
"potrzebujesz moich\n"
"specjalnych okularów...\n"
"Och, cóż...\n"
"Z drugiej strony,\n"
"może nie jesteś gotów.\n"
"Musisz spędzić tu\n"
"trochę więcej czasu\n"
"na Wyspie Delfino.\n"
"Wróć, gdy uznasz,\n"
"że jesteś gotów\n"
"na nie. Do zobaczenia!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 6 lines, the longest 20 characters
#. AI-generated
#: common/sys_message:36
msgid ""
"Hey! Sun shades\n"
"alone just won't cut\n"
"it for you. Nope!\n"
"You also need one of\n"
"my custom tropical\n"
"shirts. Here you go!"
msgstr ""
"Hej! Okulary\n"
"to za mało.\n"
"Nie!\n"
"Potrzebujesz też\n"
"mojej koszulki.\n"
"Proszę bardzo!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 9 lines, the longest 21 characters
#. AI-generated
#: common/sys_message:37
msgid ""
"My, oh my!\n"
"\n"
"\n"
"I haven't seen anyone\n"
"look that good in my\n"
"gear in ages!\n"
"Come see me again\n"
"when you want to\n"
"return them, OK?"
msgstr ""
"Ojej, ojej!\n"
"\n"
"Nigdy nie widziałem,\n"
"by ktoś tak dobrze\n"
"wyglądał w moim\n"
"sprzęcie!\n"
"Odwiedź mnie znów,\n"
"gdy będziesz chciał\n"
"oddać te rzeczy, OK?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 1 line, the longest 17 characters
#. AI-generated
#: common/sys_message:38
msgid "Are you all done?"
msgstr "Gotowe?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 3 lines, the longest 19 characters
#. AI-generated
#: common/sys_message:39
msgid ""
"Give me a holler if\n"
"you want to borrow\n"
"anything again, OK?"
msgstr ""
"Daj znać, jeśli\n"
"chcesz coś pożyczyć\n"
"jeszcze raz, OK?"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 19 characters
#. AI-generated
#: common/sys_message:40
msgid ""
"Whew! You saved me!\n"
"Thanks a bundle!"
msgstr ""
"Uff! Uratowałeś mnie!\n"
"Wielkie dzięki!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 19 characters
#. AI-generated
#: common/sys_message:41
msgid ""
"Many thanks, Mario!\n"
"You saved me!"
msgstr ""
"Dzięki, Mario!\n"
"Uratowałeś mnie!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 1 line, the longest 14 characters
#. AI-generated
#: common/sys_message:42
msgid "Thanks, Mario!"
msgstr "Dzięki, Mario!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 6 lines, the longest 22 characters
#. AI-generated
#: common/sys_message:43
msgid ""
"Brrrrpth! Bleeah!\n"
"Whoa! I really thought\n"
"I was a goner!\n"
"Hey... Hang on!\n"
"It's you! This whole\n"
"mess is your fault!"
msgstr ""
"Brrrrpth! Bleeah!\n"
"Ojej! Naprawdę myślałem,\n"
"że to już koniec!\n"
"Hej... Zaczekaj!\n"
"To ty! Ten cały\n"
"bałagan to twoja wina!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 1 line, the longest 17 characters
#. AI-generated
#: common/sys_message:44
msgid "Thanks, sweetums!"
msgstr "Dzięki, słodziaku!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 20 characters
#. AI-generated
#: common/sys_message:45
msgid ""
"You've rescued me.\n"
"Many thanks, friend."
msgstr ""
"Uratowałeś mnie.\n"
"Dzięki, przyjacielu."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 1 line, the longest 21 characters
#. AI-generated
#: common/sys_message:46 common/sys_message:49
msgid "Thanks for your help!"
msgstr "Dzięki za pomoc!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 15 characters
#. AI-generated
#: common/sys_message:47
msgid ""
"Yippee!\n"
"Thanks so much!"
msgstr ""
"Jupi!\n"
"Dzięki wielkie!"

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 22 characters
#. AI-generated
#: common/sys_message:48
msgid ""
"My, my... Thanks for\n"
"the assistance, sonny."
msgstr ""
"Ojej... Dzięki za\n"
"pomoc, chłopcze."

#. Characters' speech bubbles shared by every level: yes/no questions,
#. rewards, mini-games.
#. 2 lines, the longest 10 characters
#. AI-generated
#: common/sys_message:50
msgid ""
"Yee haaa!\n"
"Thank you!"
msgstr ""
"Juhuuu!\n"
"Dzięki!"

#. FLUDD's tips, in the balloon over his gauge.
#. 3 lines, the longest 13 characters
#. AI-generated
#: common/balloon:0
msgid ""
"Be careful of\n"
"that sludge!\n"
"Spray it!"
msgstr ""
"Uważaj na\n"
"to błoto!\n"
"Spryskaj to!"

#. FLUDD's tips, in the balloon over his gauge.
#. 4 lines, the longest 13 characters
#. AI-generated
#: common/balloon:1 common/balloon:57
msgid ""
"Press {L}\n"
"while jumping\n"
"to pound the\n"
"ground!"
msgstr ""
"Naciśnij {L}\n"
"podczas skoku,\n"
"by uderzyć\n"
"w ziemię!"

#. FLUDD's tips, in the balloon over his gauge.
#. 5 lines, the longest 13 characters
#. AI-generated
#: common/balloon:2
msgid ""
"The pump\n"
"seems to\n"
"have no\n"
"effect while\n"
"it is moving!"
msgstr ""
"Pompa\n"
"wygląda na\n"
"to, że nie\n"
"działa, gdy\n"
"się porusza!"

#. FLUDD's tips, in the balloon over his gauge.
#. 3 lines, the longest 12 characters
#. AI-generated
#: common/balloon:3
msgid ""
"You must\n"
"find a way\n"
"to fight it!"
msgstr ""
"Musisz\n"
"znaleźć sposób,\n"
"by z tym walczyć!"

#. FLUDD's tips, in the balloon over his gauge.
#. 4 lines, the longest 13 characters
#. AI-generated
#: common/balloon:4
msgid ""
"Why not try\n"
"pulling on it\n"
"by pressing\n"
"{B}?"
msgstr ""
"Spróbuj może\n"
"pociągnąć za to\n"
"naciskając\n"
"{B}?"

#. FLUDD's tips, in the balloon over his gauge.
#. 5 lines, the longest 13 characters
#. AI-generated
#: common/balloon:5
msgid ""
"Jump to\n"
"dodge those\n"
"attacks! Just\n"
"watch your\n"
"timing..."
msgstr ""
"Skacz, by\n"
"uniknąć\n"
"ataków! Tylko\n"
"pilnuj\n"
"czasu..."

#. FLUDD's tips, in the balloon over his gauge.
#. 5 lines, the longest 12 characters
#. AI-generated
#: common/balloon:6
msgid ""
"It seems you\n"
"cannot turn\n"
"it over just\n"
"by squirting\n"
"water!"
msgstr ""
"Wygląda na\n"
"to, że nie\n"
"możesz tego\n"
"obrócić samą\n"
"wodą!"

#. FLUDD's tips, in the balloon over his gauge.
#. 5 lines, the longest 11 characters
#. AI-generated
#: common/balloon:7
msgid ""
"Now is your\n"
"chance!\n"
"Attack with\n"
"a ground\n"
"pound!"
msgstr ""
"To Twój\n"
"szansa!\n"
"Uderz\n"
"z dołu!\n"
"mocno!"

#. FLUDD's tips, in the balloon over his gauge.
#. 5 lines, the longest 13 characters
#. AI-generated
#: common/balloon:8
msgid ""
"Leave it all\n"
"to me!\n"
"I will report\n"
"if I see\n"
"anything!"
msgstr ""
"Zostaw to\n"
"mi!\n"
"Daj mi znać,\n"
"jeśli zobaczysz\n"
"coś!"

#. FLUDD's tips, in the balloon over his gauge.
#. 3 lines, the longest 13 characters
#. AI-generated
#: common/balloon:9
msgid ""
"A Bullet Bill\n"
"approaches\n"
"from behind!"
msgstr ""
"Bullet Bill\n"
"nadchodzi\n"
"od tyłu!"

#. FLUDD's tips, in the balloon over his gauge.
#. 6 lines, the longest 14 characters
#. AI-generated
#: common/balloon:10
msgid ""
"You have\n"
"obtained a\n"
"water rocket!\n"
"Quick! Fire it\n"
"at Mecha-\n"
"Bowser!"
msgstr ""
"Masz\n"
"zdobyty\n"
"rakietę!\n"
"Szybko! Celuj\n"
"w Mecha-\n"
"Bowsera!"

#. FLUDD's tips, in the balloon over his gauge.
#. 4 lines, the longest 12 characters
#. AI-generated
#: common/balloon:11
msgid ""
"Danger!\n"
"Try to douse\n"
"the flames\n"
"with water!"
msgstr ""
"Uwaga!\n"
"Gasić\n"
"ogień\n"
